# random password generator # 
import random
import string


def generate_username(name):
    letters = name.replace(" ", "")

    name_letters = random.sample(letters, 4)

    lowercase = random.choice("abcdefghijklmnopqrstuvwxyz")
    uppercase = random.choice("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
    number = random.choice(string.digits)

    username = "".join(name_letters) + lowercase + uppercase + number

    username = "".join(random.sample(username, len(username)))

    return username


print("Please enter your full name")
name = input("Name: ")

while True:
    username = generate_username(name)

    if username is None:
        break

    print("\nGenerated username:", username)
    print("Secure username generated.")

    answer = input(
        "Do you wish to continue with this username? (yes/no): "
    ).lower()

    if answer == "yes":
        print("\nUsername ready for use:", username)
        break

    elif answer == "no":
        print("\nGenerating a new username.\n")

    else:
        print("Invalid answer. Please enter yes or no.")